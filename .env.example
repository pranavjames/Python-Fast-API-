# Copy to `.env` and adjust. Never commit the real `.env`.

# --- Application ---
APP_NAME="TaskFlow API"
# One of: local | test | staging | production
ENVIRONMENT=local
DEBUG=false
# Set false to hide /docs and /redoc in production
DOCS_ENABLED=true
LOG_LEVEL=INFO
# false gives human-readable logs for local development
LOG_JSON=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12
# Comma-separated list of allowed browser origins; empty disables CORS.
CORS_ORIGINS=http://localhost:3000

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=taskflow
MYSQL_PASSWORD=taskflow-password
MYSQL_DB=taskflow
# Only used by docker-compose to initialise the MySQL container
MYSQL_ROOT_PASSWORD=root-password

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# --- Server (container) ---
WEB_CONCURRENCY=2
# Set false when migrations run as a separate deploy step (e.g. a Kubernetes Job)
RUN_MIGRATIONS=true
FORWARDED_ALLOW_IPS=127.0.0.1
